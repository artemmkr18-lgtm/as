// Сглаживание пиксель-арта: тексель остаётся плоским, размывается только шов между текселями и
// ровно на ширину пикселя экрана. Обычная билинейная выборка мылит всё поле текселя, а ближайший
// сосед даёт рваный край — здесь берётся середина: край антиалиасится, рисунок не плывёт.
//
// Как это работает. Координата переводится в тексели, где целые значения — швы, а «+0.5» —
// середины текселей. Выборка прижимается к середине своего текселя везде, кроме полосы шириной в
// один пиксель экрана вокруг шва: там она линейно переезжает от середины к середине, и билинейный
// сэмплер сам мешает два текселя. Сэмплер обязан быть GL_LINEAR — переход делает именно он.
//
// При уменьшении (текселей на пиксель больше одного) делитель упирается в единицу, и формула
// вырождается в обычную билинейную выборку — иначе рисунок начал бы стягиваться к швам.
//
// Производные берутся исходные и уходят в textureGrad: сдвинутые координаты на швах скачут, и
// мип-уровень прыгал бы вместе с ними — по краю текселей пошли бы полосы.
vec4 rockstar_pixel_art(sampler2D image, vec2 uv, float softness) {
    vec2 size = vec2(textureSize(image, 0));
    vec2 texel = uv * size;

    vec2 dx = dFdx(texel);
    vec2 dy = dFdy(texel);
    vec2 width = max(abs(dx), abs(dy));
    vec2 band = clamp(width * softness, vec2(1.0e-5), vec2(1.0));

    vec2 seam = floor(texel + 0.5);
    vec2 sharp = seam + clamp((texel - seam) / band, vec2(-0.5), vec2(0.5));

    return textureGrad(image, sharp / size, dx / size, dy / size);
}

vec4 rockstar_pixel_art(sampler2D image, vec2 uv) {
    return rockstar_pixel_art(image, uv, 1.0);
}
