// common.glsl
// сглаживание края SDF — то, что умеет только фрагментный шейдер
//
// fwidth (производная по экрану) существует лишь во фрагментной стадии: производная считается
// по соседям в кваде пикселей, а у вершины соседей нет. Поэтому вершинники импортируют не этот
// файл, а rect.glsl — саму геометрию без производных; он подключается ниже, так что фрагменту
// достаточно одного импорта, как и раньше.

#moj_import <rockstar:rect.glsl>

/**
 * Ширина полосы сглаживания края SDF, в локальных единицах примитива.
 *
 * Расстояние меряется в единицах примитива, а на экране матрица может его сжать
 * (неймтеги ESP масштабируются по расстоянию, множитель 0.5-1.0): фиксированные
 * 0.5 единицы превращаются в четверть пикселя, и край идёт ступеньками. fwidth
 * даёт размер локальной единицы в пикселях кадра, поэтому полоса перехода уже
 * пикселя не становится ни при каком масштабе.
 */
float sdfAA(float dist, float smoothness) {
    return max(smoothness, fwidth(dist));
}

float ralpha(vec2 size, vec2 coord, vec4 radius, float smoothness) {
    vec2 center = size * 0.5;
    float dist = rdist(center - (coord * size), center - 1.0, radius);
    return 1.0 - smoothstep(1.0 - sdfAA(dist, smoothness), 1.0, dist);
}
